{
  "name": "@hacker-news/backend",
  "private": true,
  "scripts": {
    "dev": "dotenv -- nodemon",
    "build": "node ./esbuild.mjs",
    "serve:dev": "dotenv -- node ./dist/server.js",
    "serve:docker": "node ./dist/server.js",
    "check-build": "tsc --noEmit --incremental false",
    "lint": "eslint \"./src/**/*.{js,cjs,mjs,ts}\"",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts}\"",
    "sequelize-ts": "dotenv -- ts-node -T -r tsconfig-paths/register -P ./tsconfig.json ../../node_modules/sequelize-cli/lib/sequelize",
    "migration:add": "npm run sequelize-ts migration:generate -- --name new && ts-node -T -r ./src/scripts/sequelize/migration.ts",
    "migration:run": "npm run sequelize-ts db:migrate",
    "migration:undo": "npm run sequelize-ts db:migrate:undo",
    "migration:run:production": "npx sequelize-cli db:migrate",
    "migration:undo:production": "npx sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "node-cron": "^4.1.0",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "sequelize-typescript": "^2.1.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.15.30",
    "@types/sequelize": "^4.28.20",
    "esbuild": "^0.25.5",
    "fast-glob": "^3.3.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4"
  }
}
